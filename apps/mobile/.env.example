# Chép file này thành `.env` (cùng thư mục) rồi điền giá trị thật.
# `.env` đã bị .gitignore chặn — KHÔNG BAO GIỜ commit nó.
#
# Lấy hai giá trị này ở: Supabase Dashboard → Project Settings → API
#   Project URL  → EXPO_PUBLIC_SUPABASE_URL
#   anon public  → EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# Tiền tố EXPO_PUBLIC_ là CỐ Ý và nó nói đúng sự thật: hai giá trị này được
# nhúng vào bundle và ai cài app cũng đọc được. Đó không phải lỗ hổng — RLS mới
# là thứ bảo vệ dữ liệu, anon key chỉ nói "gọi tới project nào".

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# KHÔNG đặt service_role key ở đây, và không đặt ở bất cứ đâu trong apps/mobile.
# Nó bỏ qua toàn bộ RLS. Chỗ của nó là Supabase Dashboard → Edge Functions →
# Secrets, nơi chỉ Edge Function đọc được.
