{
  "name": "nha-minh",
  "version": "0.1.0",
  "private": true,
  "description": "Nhà mình — nơi hai người cùng nhớ việc nhà, sự kiện hai bên, khoản tiền và giấy tờ quan trọng",
  "scripts": {
    "test": "pnpm --filter @nhaminh/domain test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "mobile": "pnpm --filter @nhaminh/mobile start",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff --linked",
    "fn:deploy": "supabase functions deploy generate-task-instances build-reminders",
    "fn:serve": "supabase functions serve --env-file supabase/.env.local"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0"
}
